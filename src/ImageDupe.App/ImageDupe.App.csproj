<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app (Windows + Mac). Avalonia = WPF-style XAML + MVVM that runs everywhere. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ImageDupe</AssemblyName>
    <RootNamespace>ImageDupe.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Every platform we ship. Listed here so packages.lock.json covers all of them. -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageDupe.Core\ImageDupe.Core.csproj" />
  </ItemGroup>
</Project>
