<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageDupe.App.ViewModels"
        x:Class="ImageDupe.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="960" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />

    <Border Grid.Row="1" Margin="0,24" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="Scan and organize screens go here."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
    </Border>

    <DockPanel Grid.Row="2">
      <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Opacity="0.6" />
      <TextBlock Text="{Binding Status}" />
    </DockPanel>
  </Grid>
</Window>
